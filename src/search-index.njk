---
permalink: /assets/search-index.js
eleventyExcludeFromCollections: true
---
/* Generated at build time from all pages with a searchType. */
window.PAIR_SEARCH_INDEX = [
{%- for item in collections.searchable %}{% if not item.data.specimen %}
  {{ { url: (item.url | htmlBaseUrl), type: item.data.searchType, title: item.data.title, text: ((item.data.standfirst or item.data.summary or "") ~ " " ~ (item.content | plain)) | trim } | toJson | safe }},{% endif %}
{%- endfor %}
  null
].filter(Boolean);
