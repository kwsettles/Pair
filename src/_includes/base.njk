<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- if site.noindex %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <title>{% if pageTitle %}{{ pageTitle }} · PAIR{% elif title %}{{ title }} · PAIR{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or 'Notes on how parliaments use AI. A research blog by Kevin W. Settles.' }}">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/style.css">
  {%- include "meta.njk" %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/" aria-label="PAIR · Parliamentary AI Review, home">
        <svg class="brand__pear" viewBox="0 0 32 42" aria-hidden="true" focusable="false" fill="currentColor">
          <path d="M16 9.5c-3.6 0-4.6 3.2-4.6 6.2 0 2.9-5.4 5.3-5.4 12.8C6 35 10.5 40 16 40s10-5 10-11.5c0-7.5-5.4-9.9-5.4-12.8 0-3-1-6.2-4.6-6.2z"/>
          <path d="M15.6 10.2c.1-3 .8-5.6 2.4-7.9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M17.6 5.6c1.4-2.9 4.6-4 7.6-3.4-.9 2.9-4.2 4.6-7.6 3.4z"/>
        </svg>
        <span class="brand__text">
          <span class="wordmark">P<i>AI</i>R</span>
          <span class="brand__sub">Parliamentary AI Review</span>
        </span>
      </a>
      <form class="header-search" role="search" action="/search/" method="get">
        <label class="visually-hidden" for="site-search">Search PAIR</label>
        <input id="site-search" name="q" type="search" placeholder="Search" autocomplete="off">
        <button type="submit">Search</button>
      </form>
    </div>
  </header>
  <nav class="site-nav" aria-label="Main">
    <div class="site-nav__inner">
      <ul>
        <li><a href="/"{% if nav == "notes" %} aria-current="page"{% endif %}>Notes</a></li>
        <li><a href="/cases/"{% if nav == "cases" %} aria-current="page"{% endif %}>Cases</a></li>
        <li><a href="/method/"{% if nav == "method" %} aria-current="page"{% endif %}>Method</a></li>
        <li><a href="/about/"{% if nav == "about" %} aria-current="page"{% endif %}>About</a></li>
      </ul>
      {%- if site.previewLabel %}
      <span class="preview-flag">{{ site.previewLabel }}</span>
      {%- endif %}
    </div>
  </nav>
  <main id="main">
{{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="site-footer__inner">
      <span class="footer-name">PAIR · Parliamentary AI Review</span>
      <a href="/about/#how-ai-is-used">AI use &amp; editorial responsibility</a>
      <span class="copyright">© 2026 {{ site.author }} · <a href="/legal-notice/">Legal notice</a> · <a href="/privacy/">Privacy</a></span>
    </div>
  </footer>
  <script src="/assets/cite.js" defer></script>
  {%- if scripts %}{% for s in scripts %}
  <script src="{{ s }}"></script>{% endfor %}{% endif %}
</body>
</html>
