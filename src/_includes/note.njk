---
layout: base.njk
---
    <article class="column prose contribution">
      <header class="article-header">
        <p class="meta"><span class="marker marker--{{ formats[format].key }}" aria-hidden="true"></span>{{ format }} · {{ status }} · Version {{ version }}</p>
        <span class="format-rule format-rule--{{ formats[format].key }}" aria-hidden="true"></span>
        <h1>{{ title }}</h1>
        {% include "byline.njk" %}
        {%- if standfirst %}
        <p class="standfirst">{{ standfirst }}</p>
        {%- endif %}
        <dl class="dates">
          <dt>{% if published %}Published{% else %}Draft dated{% endif %}</dt><dd><time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time></dd>
          <dt>Last revised</dt><dd><time datetime="{{ (updated or page.date) | isoDate }}">{{ (updated or page.date) | longDate }}</time> (v{{ version }})</dd>
          {%- if last_verified %}
          <dt>Sources last checked</dt><dd><time datetime="{{ last_verified | isoDate }}">{{ last_verified | longDate }}</time></dd>
          {%- endif %}
          {%- if not published %}
          <dt>Published</dt><dd>Not yet published</dd>
          {%- endif %}
          {%- if received %}
          <dt>Received</dt><dd><time datetime="{{ received | isoDate }}">{{ received | longDate }}</time></dd>
          {%- endif %}
          {%- if accepted %}
          <dt>Accepted</dt><dd><time datetime="{{ accepted | isoDate }}">{{ accepted | longDate }}</time></dd>
          {%- endif %}
          {%- if site.editor not in authors %}
          <dt>Review</dt><dd>Editorial review by {{ (people | pick([site.editor]))[0].name }}. Not peer reviewed.</dd>
          {%- endif %}
          {%- if cases and cases.length %}
          <dt>Cases</dt><dd>{% for id in cases %}{% set c = collections.cases | caseById(id) %}{% if c %}<a href="{{ c.url }}">{{ id }}</a>{% else %}{{ id }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
          {%- endif %}
        </dl>
      </header>

      <div class="body">
{{ content | safe }}
      </div>

{% include "endmatter.njk" %}
    </article>
